TELEGRAM_BOT_TOKEN=your_token_here
OPENAI_API_KEY=your_key_here
CHROMA_PERSIST_DIR=./data/chroma_db
FEEDBACK_PATH=./data/feedback.jsonl
CHECKPOINT_PATH=./data/checkpoints.sqlite
BOT_MODE=polling
WEBHOOK_URL=https://your-app.example.com/webhook
PORT=8443

# Optional: what one chat may send per day. /limits moves both from the
# operator's chat while the bot runs; a restart puts them back to these, so
# a number that proves right belongs here.
DAILY_TEXT_LIMIT=30
DAILY_PHOTO_LIMIT=5

# Optional: chat that receives operator alerts (dead credit, rejected key).
# Message the bot from that chat once first, or Telegram refuses delivery.
# Leave empty to turn the alerts off.
ADMIN_CHAT_ID=

# Optional: public channel users subscribe to for announcements, as its
# @username. Add the bot to the channel as an administrator, or it cannot
# post. Leave empty to turn announcements off; /start then says nothing
# about a channel and no announcement is ever offered.
ANNOUNCEMENT_CHANNEL=
